# ==============================================================================
# Shine Peerpath - Environment Configuration
# ==============================================================================

# Backend Server Port (Default: 5001)
PORT=5001
API_PORT=5001

# Node Environment ('development' | 'production')
NODE_ENV=development

# Optional: Frontend API URL (leave empty when serving unified on same host)
# VITE_API_URL=https://api.peerpath.shine.com

# Optional: Shine SSO & Integration Keys (if connecting to external Shine gateway)
# SHINE_SSO_GATEWAY_URL=https://auth.shine.com
